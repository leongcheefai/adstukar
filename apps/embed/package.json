{
  "name": "@repo/embed",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./react": {
      "types": "./src/react.tsx",
      "default": "./dist/react.js"
    }
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build && vite build -c vite.react.config.ts && node scripts/check-size.mjs",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@repo/config": "workspace:*",
    "@types/react": "^19.0.0",
    "react": "^19.0.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.0"
  }
}
