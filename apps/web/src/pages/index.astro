---
import { project } from "@repo/config/project";
import { LandingContent } from "../components/LandingContent";
import BaseLayout from "../layouts/BaseLayout.astro";
import { LANDING_FAQ } from "../lib/faq";
import { requirePage } from "../lib/pages";
import { faqSchema, orgSchema, websiteSchema } from "../lib/structured-data";

const page = requirePage("home");
const site = Astro.site ?? new URL(project.siteUrl);

// The same questions the landing page renders, so the JSON-LD cannot drift from the copy.
const faqItems = LANDING_FAQ;

const jsonLd = [orgSchema(site), websiteSchema(site), faqSchema(faqItems)];
---

<BaseLayout
  title={page.title}
  description={page.description}
  jsonLd={jsonLd}
>
  <LandingContent />
</BaseLayout>
