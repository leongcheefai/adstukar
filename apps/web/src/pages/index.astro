---
import { project } from "@repo/config/project";
import { Landing } from "../components/landing/Landing";
import { LiveTicker } from "../components/landing/LiveTicker";
import BaseLayout from "../layouts/BaseLayout.astro";
import { landingFaq } from "../lib/faq";
import landingConfig from "../lib/landing.config.json";
import { parseLandingConfig } from "../lib/landing/config";
import { requirePage } from "../lib/pages";
import { faqSchema, orgSchema, websiteSchema } from "../lib/structured-data";

const page = requirePage("home");
const site = Astro.site ?? new URL(project.siteUrl);

// The page is a pure function of the saved config. Change it in /lab/landing.
const config = parseLandingConfig(landingConfig);
const faqItems = landingFaq(config.faqPerGroup).flatMap((group) => group.items);
const jsonLd = [orgSchema(site), websiteSchema(site), faqSchema(faqItems)];
---

<BaseLayout
  title={page.title}
  description={page.description}
  jsonLd={jsonLd}
  bleed
>
  <Landing config={config}>
    <LiveTicker slot="ticker" variant="hero" client:visible />
  </Landing>
</BaseLayout>

<script>
  import { env } from "../lib/env";

  // A member who types the site's address wants their set, not the pitch. The
  // page is static, so the check runs here: ask the API for the session, and
  // go to the app when there is one. `from=app` means the app has just sent
  // the visitor here as signed out, and the two must not trade them for ever.
  // Any failure leaves the landing page as it is.
  const url = new URL(window.location.href);
  if (url.searchParams.has("from")) {
    url.searchParams.delete("from");
    window.history.replaceState(null, "", url);
  } else {
    fetch(`${env.PUBLIC_API_URL}/api/auth/get-session`, { credentials: "include" })
      .then((res) => (res.ok ? res.json() : null))
      .then((body) => {
        if (body?.session) window.location.replace(env.PUBLIC_APP_URL);
      })
      .catch(() => {});
  }
</script>
