---
import { getCollection, render } from "astro:content";
import { project } from "@repo/config/project";
import { Badge } from "@repo/ui";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { pageTitle } from "../../lib/pages";
import { readingTime } from "../../lib/reading-time";
import { pageDates } from "../../lib/seo/sitemap";
import { articleSchema, breadcrumbSchema } from "../../lib/structured-data";

export async function getStaticPaths() {
  // A draft has no page: the index, the RSS feed, and the sitemap skip it too.
  const posts = (await getCollection("blog")).filter((post) => !post.data.draft);
  return posts.map((post) => ({
    params: { id: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, remarkPluginFrontmatter } = await render(post);
const site = Astro.site ?? new URL(project.siteUrl);
const canonicalURL = new URL(Astro.url.pathname, site).href;

// Use remark-estimated-reading-time if available, otherwise fall back to our util
const rt = remarkPluginFrontmatter?.readingTime ?? readingTime(post.body ?? "").text;

const jsonLd = [
  articleSchema({
    title: post.data.title,
    description: post.data.description,
    date: post.data.date,
    modified: pageDates(canonicalURL).modified,
    author: post.data.author,
    image: new URL(post.data.image ?? `/og/blog-${post.id}.png`, site).href,
    url: canonicalURL,
    site,
  }),
  breadcrumbSchema([
    { name: "Home", url: site.origin },
    { name: "Blog", url: new URL("/blog", site).href },
    { name: post.data.title, url: canonicalURL },
  ]),
];
---

<BaseLayout
  title={pageTitle(post.data.title)}
  description={post.data.description}
  ogSlug={`blog-${post.id}`}
  ogType="article"
  published={post.data.date}
  jsonLd={jsonLd}
>
  <div class="mx-auto max-w-3xl px-6 py-24 sm:py-32">
    <a
      href="/blog"
      class="text-sm text-muted-foreground transition-colors hover:text-foreground"
    >
      ← Back to blog
    </a>
    <article class="mt-8">
      {post.data.image && (
        <img
          src={post.data.image}
          alt={post.data.imageAlt ?? post.data.title}
          class="mb-8 aspect-video w-full rounded-xl object-cover"
        />
      )}
      <header class="mb-10">
        <div class="flex flex-wrap items-center gap-2 text-sm text-muted-foreground">
          <time datetime={post.data.date.toISOString()}>
            {post.data.date.toLocaleDateString("en-US", {
              year: "numeric",
              month: "long",
              day: "numeric",
            })}
          </time>
          <span aria-hidden="true">·</span>
          <span>{rt}</span>
          {post.data.tags.length > 0 && (
            <>
              <span aria-hidden="true">·</span>
              {post.data.tags.map((tag) => (
                <Badge key={tag} variant="secondary" className="text-xs">
                  {tag}
                </Badge>
              ))}
            </>
          )}
        </div>
        <h1 class="mt-3 text-4xl font-medium tracking-tight">{post.data.title}</h1>
        <p class="mt-3 text-lg text-muted-foreground">{post.data.description}</p>
        <p class="mt-4 text-sm text-muted-foreground">By {post.data.author}</p>
      </header>
      <div class="prose">
        <Content />
      </div>
    </article>
  </div>
</BaseLayout>
