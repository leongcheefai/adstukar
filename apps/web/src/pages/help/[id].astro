---
import { getCollection, render } from "astro:content";
import { project } from "@repo/config/project";
import HelpLayout from "../../layouts/HelpLayout.astro";
import { HELP_SEARCH_HASH } from "../../lib/help";
import { pageTitle } from "../../lib/pages";
import { pageDates } from "../../lib/seo/sitemap";
import { articleSchema, breadcrumbSchema } from "../../lib/structured-data";

export async function getStaticPaths() {
  const topics = await getCollection("help");
  return topics
    .filter((topic) => !topic.data.draft)
    .map((topic) => ({
      params: { id: topic.id },
      props: { topic },
    }));
}

const { topic } = Astro.props;
const { Content, headings } = await render(topic);
const site = Astro.site ?? new URL(project.siteUrl);

/* The side menu lists the `##` headings; the `###` ones stay in the text. */
const sections = headings.filter((h) => h.depth === 2).map(({ slug, text }) => ({ slug, text }));

// The same form as the canonical BaseLayout writes, so the schema names the page it sits on.
const url = new URL(Astro.url.pathname, site).href;
const dates = pageDates(url);
const jsonLd = [
  articleSchema({
    type: "TechArticle",
    title: topic.data.title,
    description: topic.data.description,
    date: dates.published ? new Date(dates.published) : undefined,
    modified: dates.modified,
    image: new URL(`/og/help-${topic.id}.png`, site).href,
    url,
    site,
  }),
  breadcrumbSchema([
    { name: "Home", url: site.origin },
    { name: "Help", url: new URL("/help", site).href },
    { name: topic.data.title, url },
  ]),
];
---

<HelpLayout
  title={pageTitle(`${topic.data.title} | Help Center`)}
  description={topic.data.description}
  ogSlug={`help-${topic.id}`}
  ogType="article"
  jsonLd={jsonLd}
  current={{ id: topic.id, sections }}
>
  <div class="max-w-3xl">
    <article>
      <header class="mb-10">
        <h1 class="text-4xl font-medium tracking-tight">{topic.data.title}</h1>
      </header>
      <div class="prose prose-help">
        <Content />
      </div>
    </article>
  </div>

  <!-- The search field lives on the help home, so ⌘K here goes to it. -->
  <script is:inline define:vars={{ searchUrl: `/help${HELP_SEARCH_HASH}` }}>
    window.addEventListener("keydown", (event) => {
      if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === "k") {
        event.preventDefault();
        window.location.href = searchUrl;
      }
    });
  </script>
</HelpLayout>
