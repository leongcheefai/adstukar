---
import { getCollection } from "astro:content";
import { project } from "@repo/config/project";
import { HelpMessageForm } from "../../components/help/HelpMessageForm";
import { HelpSearch } from "../../components/help/HelpSearch";
import HelpLayout from "../../layouts/HelpLayout.astro";
import { helpSections } from "../../lib/help-search";
import { requirePage } from "../../lib/pages";
import { breadcrumbSchema } from "../../lib/structured-data";

const page = requirePage("help");
const site = Astro.site ?? new URL(project.siteUrl);

const entries = (await getCollection("help"))
  .filter((topic) => !topic.data.draft)
  .sort((a, b) => a.data.order - b.data.order)
  .flatMap((topic) => helpSections({ id: topic.id, title: topic.data.title }, topic.body ?? ""));

const jsonLd = breadcrumbSchema([
  { name: "Home", url: site.origin },
  { name: "Help", url: new URL("/help", site).href },
]);
---

<HelpLayout title={page.title} description={page.description} ogSlug={page.slug} jsonLd={jsonLd}>
  <div class="mx-auto max-w-3xl lg:pt-16">
    <h1 class="text-center text-4xl font-medium tracking-tight">Hello. How can we help you?</h1>
    <HelpSearch client:load entries={entries} supportEmail={project.email.support} />
    <HelpMessageForm client:load />
  </div>
</HelpLayout>
