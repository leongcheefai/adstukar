---
import { project } from "@repo/config/project";
import { Container, Section, SectionHeader } from "@repo/ui";
import BaseLayout from "../layouts/BaseLayout.astro";
import { isHidden, requirePage } from "../lib/pages";

const page = requirePage("security");

const highlights = [
  {
    title: "Encrypted in transit",
    description:
      "The website, the dashboard, the API, the set, and file downloads are served only over HTTPS. The sign-in cookie is sent only over HTTPS and cannot be read by page scripts.",
  },
  {
    title: "Passwords and sign-in",
    description:
      "We store only a one-way hash of each password, never the password itself. You can also sign in with Google. Every admin action checks the admin role on the server, on every request.",
  },
  {
    title: "Payments stay with Stripe",
    description:
      "You pay on Stripe's own checkout page, and payouts go through Stripe Connect. Card numbers and bank details never reach our servers. Stripe is certified to PCI DSS Level 1.",
  },
  {
    title: "Money is append-only",
    description:
      "Every movement of money is a new ledger entry that is never edited or deleted. Each payment and payout is keyed so that a retry cannot count it twice, and a person reviews every payout before it is sent.",
  },
  {
    title: "Screens and uploads",
    description:
      "A person approves every screen and every listing. Each screen has its own access key, which its owner can replace at any time. Uploads go straight to storage through short-lived links that allow one file of a set size and type.",
  },
  {
    title: "Where data lives",
    description: `The application and its database run on Railway in Singapore. The websites run on Vercel, and files are stored in Cloudflare R2. ${project.name} runs no analytics or advertising trackers.`,
  },
];
---

<BaseLayout
  title={page.title}
  description={page.description}
  noindex={isHidden(page)}
  ogSlug={page.slug}
>
  <Section spacing="tight">
    <Container size="prose">
      <SectionHeader
        as="h1"
        align="center"
        headline={`Security at ${project.name}`}
        lede="How we protect member accounts, payments, and screens. This page describes the Service as it runs today."
      />
    </Container>
  </Section>

  <Section spacing="tight">
    <Container>
      <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
        {highlights.map((h) => (
          <div class="rounded-lg border border-border bg-card p-6">
            <h2 class="text-lg font-medium">{h.title}</h2>
            <p class="mt-2 text-sm text-muted-foreground">{h.description}</p>
          </div>
        ))}
      </div>
    </Container>
  </Section>

  <Section>
    <Container size="prose">
      <div class="prose">
        <h2>Still to confirm</h2>
        <p>
          <strong>[TBD: database backups — how often, how long they are kept, and when a restore
          was last tested.]</strong>
        </p>
        <p>
          <strong>[TBD: encryption at rest for the database on Railway. Cloudflare R2 encrypts
          stored files at rest.]</strong>
        </p>
        <p>
          <strong>[TBD: who has access to production systems, and whether that access uses
          two-factor sign-in.]</strong>
        </p>

        <h2>Reporting a vulnerability</h2>
        <p>
          If you find a security problem, email <a href={`mailto:${project.email.support}`}>{project.email.support}</a>
          with the subject line "Security". Tell us what you found and how to reproduce it. Please
          give us a reasonable time to fix it before you share it, and do not access other members'
          data or disrupt the Service while you test. We do not run a paid bug bounty.
        </p>

        <h2>Service providers</h2>
        <p>
          Stripe (payments and payouts), Railway (application and database), Vercel (websites),
          Cloudflare R2 (file storage), Resend (email), and Google (optional
          sign-in). Our <a href="/privacy">Privacy Policy</a> says what each one
          receives.
        </p>
      </div>
    </Container>
  </Section>
</BaseLayout>
