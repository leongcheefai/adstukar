---
import { project } from "@repo/config/project";
import { FAQ } from "@repo/ui";
import BaseLayout from "../layouts/BaseLayout.astro";
import { FAQ_PAGE } from "../lib/faq";
import { requirePage } from "../lib/pages";
import { breadcrumbSchema, faqSchema } from "../lib/structured-data";

const page = requirePage("faq");
const site = Astro.site ?? new URL(project.siteUrl);

const faqItems = FAQ_PAGE;

const jsonLd = [
  faqSchema(faqItems),
  breadcrumbSchema([
    { name: "Home", url: site.origin },
    { name: "FAQ", url: new URL("/faq", site).href },
  ]),
];
---

<BaseLayout
  title={page.title}
  description={page.description}
  ogSlug={page.slug}
  jsonLd={jsonLd}
>
  <FAQ eyebrow="FAQ" headline={`Questions about ${project.name}`} items={faqItems} />
</BaseLayout>
