---
import { project } from "@repo/config/project";
import { FaqSections } from "../components/landing/FaqSections";
import BaseLayout from "../layouts/BaseLayout.astro";
import { FAQ_ALL, FAQ_GROUPS } from "../lib/faq";
import { requirePage } from "../lib/pages";
import { breadcrumbSchema, faqSchema } from "../lib/structured-data";

const page = requirePage("faq");
const site = Astro.site ?? new URL(project.siteUrl);

const jsonLd = [
  faqSchema(FAQ_ALL),
  breadcrumbSchema([
    { name: "Home", url: site.origin },
    { name: "FAQ", url: new URL("/faq", site).href },
  ]),
];
---

<BaseLayout
  title={page.title}
  description={page.description}
  ogSlug={page.slug}
  jsonLd={jsonLd}
>
  <FaqSections
    groups={FAQ_GROUPS}
    full
    nav
    headingAs="h1"
    id="questions"
    eyebrow="FAQ"
    headline={`Questions about ${project.name}`}
    lede={`Everything a screen owner and an advertiser ask, with every number taken from the rules the network runs on. Still stuck? Write to ${project.email.support}.`}
  />
</BaseLayout>
