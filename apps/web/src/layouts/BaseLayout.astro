---
import "../styles/global.css";
import { project } from "@repo/config/project";
import Footer from "../components/Footer";
import Nav from "../components/Nav.astro";
import { LiveTicker } from "../components/landing/LiveTicker";
import landingConfig from "../lib/landing.config.json";
import { parseLandingConfig } from "../lib/landing/config";

interface Props {
  title: string;
  description: string;
  ogSlug?: string;
  ogType?: "website" | "article";
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  /** The fixed ticker at the foot. Follows the landing config unless a page turns it off. */
  crawl?: boolean;
  /** The first section runs under the floating header, so its ground shows behind the card. */
  bleed?: boolean;
}

const {
  title,
  description,
  ogSlug = "home",
  ogType = "website",
  jsonLd,
  crawl = true,
  bleed = false,
} = Astro.props;
const site = Astro.site ?? new URL(project.siteUrl);
const canonicalURL = new URL(Astro.url.pathname, site);
const ogImage = new URL(`/og/${ogSlug}.png`, site);
const jsonLdArray = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];

// The ticker is the same on every page: the welcome, and the live total.
const landing = parseLandingConfig(landingConfig);
const showCrawl = crawl && landing.footCrawl;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <!-- The marketing site is light only. This keeps the browser from painting
         form controls and scrollbars dark for a visitor whose OS is set to dark. -->
    <meta name="color-scheme" content="light" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" type="application/rss+xml" title={`${project.name} Blog`} href="/rss.xml" />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={project.name} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    {jsonLdArray.map((payload) => (
      <script is:inline type="application/ld+json" set:html={JSON.stringify(payload)} />
    ))}
  </head>
  <body data-crawl={showCrawl ? "" : undefined} data-bleed={bleed ? "" : undefined}>
    <Nav />
    <main id="main">
      <slot />
    </main>
    <Footer />
    {/* client:load, not visible: the strip is fixed in view from the first
        paint, and the figure it carries has to be fetched. */}
    {showCrawl && <LiveTicker variant="foot" client:load />}
  </body>
</html>
