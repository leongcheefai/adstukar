---
import "../styles/global.css";
import { project } from "@repo/config/project";
import Footer from "../components/Footer";
import Nav from "../components/Nav.astro";
import { LiveTicker } from "../components/landing/LiveTicker";
import landingConfig from "../lib/landing.config.json";
import { parseLandingConfig } from "../lib/landing/config";
import { THEME_COLOR } from "../lib/seo/brand";
import { pageDates } from "../lib/seo/sitemap";
import { orgSchema, webPageSchema, websiteSchema } from "../lib/structured-data";

interface Props {
  title: string;
  description: string;
  ogSlug?: string;
  ogType?: "website" | "article";
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  /** Keep the page out of search. A page with no real copy yet sets this. */
  noindex?: boolean;
  /** The fixed ticker at the foot. Follows the landing config unless a page turns it off. */
  crawl?: boolean;
  /** The first section runs under the floating header, so its ground shows behind the card. */
  bleed?: boolean;
  /** The floating site header. The help centre turns it off and brings its own side menu. */
  nav?: boolean;
  /** An article's own publish date (a blog post's frontmatter). Otherwise the first commit on its sources. */
  published?: Date;
}

const {
  title,
  description,
  ogSlug = "home",
  ogType = "website",
  jsonLd,
  noindex = false,
  crawl = true,
  bleed = false,
  nav = true,
  published,
} = Astro.props;
const site = Astro.site ?? new URL(project.siteUrl);
const canonicalURL = new URL(Astro.url.pathname, site);
const ogImage = new URL(`/og/${ogSlug}.png`, site);
// When the page last changed, read from git: a freshness signal for search and AI engines.
const dates = pageDates(canonicalURL.href);
const publishedTime = published?.toISOString() ?? dates.published;
// Every page names its publisher and its site, so the other schemas' `@id` links resolve on the page.
const jsonLdArray = [
  orgSchema(site),
  websiteSchema(site),
  webPageSchema({
    url: canonicalURL.href,
    title,
    description,
    image: ogImage.href,
    modified: dates.modified,
    site,
  }),
  ...(jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : []),
];

// The ticker is the same on every page: the welcome, and the live total.
const landing = parseLandingConfig(landingConfig);
const showCrawl = crawl && landing.footCrawl;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content={THEME_COLOR} />
    <meta name="generator" content={Astro.generator} />
    <!-- The marketing site is light only. This keeps the browser from painting
         form controls and scrollbars dark for a visitor whose OS is set to dark. -->
    <meta name="color-scheme" content="light" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta
      name="robots"
      content={noindex ? "noindex, follow" : "index, follow, max-image-preview:large, max-snippet:-1"}
    />
    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" type="application/rss+xml" title={`${project.name} Blog`} href="/rss.xml" />
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
    <!-- The site in plain text for AI answer engines (the llms.txt convention). -->
    <link rel="alternate" type="text/plain" title={`${project.name} for LLMs`} href="/llms.txt" />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={project.name} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    {ogType === "article" && publishedTime && (
      <meta property="article:published_time" content={publishedTime} />
    )}
    {ogType === "article" && dates.modified && (
      <meta property="article:modified_time" content={dates.modified} />
    )}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={title} />
    {jsonLdArray.map((payload) => (
      <script is:inline type="application/ld+json" set:html={JSON.stringify(payload)} />
    ))}
  </head>
  <body data-crawl={showCrawl ? "" : undefined} data-bleed={bleed ? "" : undefined}>
    {nav && <Nav />}
    <main id="main">
      <slot />
    </main>
    <Footer />
    {/* client:load, not visible: the strip is fixed in view from the first
        paint, and the figure it carries has to be fetched. */}
    {showCrawl && <LiveTicker variant="foot" client:load />}
  </body>
</html>
