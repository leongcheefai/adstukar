---
import { getCollection } from "astro:content";
import { project } from "@repo/config/project";
import { env } from "../lib/env";
import { MobileNav } from "./MobileNav";
import { ThemeToggle } from "./ThemeToggle";
import { WhatsNewMenu } from "./WhatsNewMenu";

const APP_URL = env.PUBLIC_APP_URL;
const navLinks = [
  { label: "How it works", href: "/#how-it-works" },
  { label: "FAQ", href: "/faq" },
  { label: "Blog", href: "/blog" },
];

const recentReleases = (await getCollection("releases"))
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime())
  .slice(0, 4)
  .map((r) => ({
    id: r.id,
    name: r.data.name,
    publishedAt: r.data.publishedAt.toISOString(),
  }));
---

<header class="sticky top-0 z-50 border-b border-border/60 bg-background/80 backdrop-blur-sm">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-6">
    <a href="/" class="text-lg font-bold tracking-tight">{project.name}</a>

    <nav class="hidden items-center gap-6 md:flex" aria-label="Main navigation">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class="text-sm text-muted-foreground transition-colors hover:text-foreground"
        >
          {link.label}
        </a>
      ))}
      <WhatsNewMenu client:load releases={recentReleases} />
    </nav>

    <div class="flex items-center gap-2">
      <ThemeToggle client:load />
      <div class="hidden items-center gap-3 md:flex">
        <a
          href={`${APP_URL}/login`}
          class="text-sm text-muted-foreground transition-colors hover:text-foreground"
        >
          Sign in
        </a>
        <a
          href={`${APP_URL}/signup`}
          class="inline-flex h-9 items-center justify-center rounded-md bg-primary px-4 text-sm font-medium text-primary-foreground transition-colors hover:bg-primary/90"
        >
          Get started
        </a>
      </div>
      <MobileNav client:load navItems={navLinks} appUrl={APP_URL} brand={project.name} />
    </div>
  </div>
</header>
