---
import { project } from "@repo/config/project";
import { Logo } from "@repo/ui";
import { env } from "../lib/env";

const APP_URL = env.PUBLIC_APP_URL;

/* Anchors on the landing page, plus the one page that answers the rest. On a
   phone the row folds to the logo and the one button: every link here is also
   in the footer, and a drawer is more nav than a four-section site needs. The
   rates sit under "How it works" on the page, and the footer links them. */
const links = [
  { label: "How it works", href: "/#how-it-works" },
  { label: "Advertisers", href: "/#advertisers" },
  { label: "FAQ", href: "/faq" },
] as const;

/* Text links bleed vertically only, so neighbours in the row cannot overlap. */
const TEXT_LINK =
  "relative text-sm text-muted-foreground transition-colors duration-150 ease-out before:absolute before:inset-x-0 before:-inset-y-3 hover:text-foreground";
---

<a
  href="#main"
  class="sr-only focus:not-sr-only focus:absolute focus:top-3 focus:left-3 focus:z-(--z-skip-link) focus:rounded-full focus:bg-primary focus:px-5 focus:py-2.5 focus:text-sm focus:font-medium focus:text-primary-foreground"
>
  Skip to content
</a>

<!-- A card that floats over the page rather than a bar across it. The wrapper
     is clear, so on the home page the blue hero runs behind the card; the
     card's own ground and shadow keep it legible on a white page too. Its
     height is --header-h, which the page reads for anchors and the bleed. -->
<header class="sticky top-0 z-(--z-header) px-4 pt-4 sm:px-6 sm:pt-6">
  <div
    class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-6 rounded-[8px] border border-border/60 bg-card pl-5 pr-3 shadow-elev-2 sm:pl-6"
  >
    <a
      href="/"
      class="relative inline-flex text-primary transition-opacity duration-150 ease-out before:absolute before:inset-x-0 before:-inset-y-3 hover:opacity-80"
      aria-label={project.name}
    >
      <Logo variant="mark" size={32} aria-hidden="true" />
    </a>

    <!-- The links sit with the button on the right, so the row reads logo,
         then everything a visitor can do. -->
    <div class="flex items-center gap-6">
      <nav class="hidden items-center gap-6 md:flex" aria-label="Main">
        {links.map((link) => (
          <a href={link.href} class={TEXT_LINK}>
            {link.label}
          </a>
        ))}
      </nav>

      <!-- One button. The app's front door is the set itself: it boots, then
           asks for a session or shows the sources, so sign-in and sign-up both
           live behind the same switch. -->
      <a
        href={APP_URL}
        class="relative inline-flex h-11 items-center justify-center rounded-[8px] bg-primary px-6 text-base font-medium text-primary-foreground transition-[background-color,transform] duration-150 ease-out before:absolute before:inset-x-0 before:-inset-y-0.5 hover:bg-[color:var(--color-accent-hover)] active:scale-[0.96] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary/40"
      >
        Turn on TV
      </a>
    </div>
  </div>
</header>
