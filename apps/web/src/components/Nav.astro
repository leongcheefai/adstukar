---
import { project } from "@repo/config/project";
import { Logo } from "@repo/ui";
import { env } from "../lib/env";
import { MobileNav } from "./MobileNav";

const APP_URL = env.PUBLIC_APP_URL;
const navLinks = [
  { label: "How it works", href: "/#how-it-works" },
  { label: "FAQ", href: "/faq" },
  { label: "Blog", href: "/blog" },
];
---

<a
  href="#main"
  class="sr-only focus:not-sr-only focus:absolute focus:top-3 focus:left-3 focus:z-(--z-skip-link) focus:rounded-full focus:bg-primary focus:px-5 focus:py-2.5 focus:text-sm focus:font-medium focus:text-primary-foreground"
>
  Skip to content
</a>

<header
  class="sticky top-0 z-(--z-header) border-b border-border/60 bg-background/80 backdrop-blur-sm"
>
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-6">
    <a
      href="/"
      class="relative inline-flex text-primary transition-opacity duration-150 ease-out before:absolute before:inset-x-0 before:-inset-y-2 hover:opacity-80"
      aria-label={project.name}
    >
      <Logo size={26} />
    </a>

    <nav class="hidden items-center gap-6 md:flex" aria-label="Main navigation">
      {navLinks.map((link) => (
        <!-- The bleed grows vertically only, so neighbouring targets in the
             row can never overlap each other. -->
        <a
          href={link.href}
          class="relative text-sm text-muted-foreground transition-colors duration-150 ease-out before:absolute before:inset-x-0 before:-inset-y-3 hover:text-foreground"
        >
          {link.label}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-2">
      <div class="hidden items-center gap-3 md:flex">
        <a
          href={`${APP_URL}/login`}
          class="relative text-sm text-muted-foreground transition-colors duration-150 ease-out before:absolute before:inset-x-0 before:-inset-y-3 hover:text-foreground"
        >
          Sign in
        </a>
        <a
          href={`${APP_URL}/signup`}
          class="relative inline-flex h-9 items-center justify-center rounded-full bg-primary px-5 text-sm font-medium text-primary-foreground transition-[background-color,transform] duration-150 ease-out before:absolute before:inset-x-0 before:-inset-y-0.5 hover:bg-[color:var(--color-accent-hover)] active:scale-[0.98] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary/40"
        >
          Get started
        </a>
      </div>
      <MobileNav client:load navItems={navLinks} appUrl={APP_URL} brand={project.name} />
    </div>
  </div>
</header>
