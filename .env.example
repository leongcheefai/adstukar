# Copy to .env and fill in values. This is the ONLY .env file in the repo —
# apps/api, drizzle-kit, apps/app (Vite) and apps/web (Astro) all read it.
#
# Server vars are validated by packages/env at startup; a missing required one throws.
# VITE_-prefixed vars reach the dashboard bundle and PUBLIC_-prefixed vars reach the
# marketing bundle — never put a secret in either. Everything else stays server-side.

# ── Required ────────────────────────────────────────────────────────────────

# Database (matches docker-compose.yml defaults)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/praxor_kit

# Auth — generate with: openssl rand -base64 33
BETTER_AUTH_SECRET=change-me-at-least-32-characters-long!!

# ── Server (defaults shown; safe to leave as-is for local dev) ──────────────

NODE_ENV=development
PORT=3001
BETTER_AUTH_URL=http://localhost:3001
APP_URL=http://localhost:3000
# Marketing site origin — used for CORS on /billing/config and checkout.
# Required in production — set to the deployed marketing origin (e.g. https://your-domain.com)
WEB_URL=http://localhost:4321

# ── Client (browser-exposed — never put secrets here) ───────────────────────

# Dashboard (apps/app) — API base URL for the auth client and fetch wrappers
VITE_API_URL=http://localhost:3001

# Marketing site (apps/web) — dashboard URL for Sign in / Get started links
PUBLIC_APP_URL=http://localhost:3000
# Marketing site (apps/web) — API base URL for billing config and checkout
PUBLIC_API_URL=http://localhost:3001

# ── Optional: Google OAuth ──────────────────────────────────────────────────
# Both must be set for Google sign-in to activate.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# ── Optional: Stripe ────────────────────────────────────────────────────────
# Leave unset to disable billing (app still boots).
# Get from https://dashboard.stripe.com/test/apikeys
# STRIPE_SECRET_KEY=sk_test_...
# Get from: stripe listen --forward-to localhost:3001/billing/webhook
# STRIPE_WEBHOOK_SECRET=whsec_...
# Pro plan price IDs (monthly and yearly)
# STRIPE_PRO_PRICE_ID_MONTHLY=price_...
# STRIPE_PRO_PRICE_ID_YEARLY=price_...

# ── Optional: Resend ────────────────────────────────────────────────────────
# Get from https://resend.com/api-keys
# Leave unset to skip email sends (app still boots, logs a warning)
# RESEND_API_KEY=re_...

# ── Optional: S3-compatible storage for avatar uploads (AWS S3 or Cloudflare R2)
# Leave unset to disable avatar uploads (app still boots)
# S3_REGION=auto                 # 'auto' for R2; 'us-east-1' etc. for AWS S3
# S3_BUCKET=your-bucket-name
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com  # Cloudflare R2 only
# S3_PUBLIC_URL=https://pub-<hash>.r2.dev                    # CDN base URL for served assets

# ── Optional: GitHub feedback → issue ───────────────────────────────────────
# When set, each submitted feedback also opens a GitHub issue in the configured repo.
# PAT requires repo:issues write scope (fine-grained or classic).
# GITHUB_TOKEN=ghp_...
# GITHUB_OWNER=your-org-or-user
# GITHUB_REPO=your-repo
